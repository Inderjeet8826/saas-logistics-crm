# Database
DATABASE_URL=postgresql://user:password@localhost:5432/logistics_crm

# JWT Auth
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Domain
BASE_DOMAIN=yourapp.com
FRONTEND_ORIGIN=http://localhost:3000

# App
ENVIRONMENT=development

# SMTP Email Configuration (Optional - logs to console if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@logistics-crm.com
SMTP_FROM_NAME="Logistics CRM Platform"
SMTP_TLS=True
